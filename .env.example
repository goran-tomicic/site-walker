# Anthropic API key — get from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Model to use for page-state interpretation + friction notes (vision-capable)
CLAUDE_MODEL=claude-sonnet-5

# Browser automation
# If self-hosting Playwright, no extra keys needed — just `npm install playwright && npx playwright install`
# If using a hosted browser-use API instead, set its key here:
BROWSER_USE_API_KEY=

# Safety guard: comma-separated list of allowed target domains, enforced in code before navigation
ALLOWED_TARGET_DOMAINS=formatik.studio
