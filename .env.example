# Anthropic API key — get from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Model to use for page-state interpretation + friction notes (vision-capable)
CLAUDE_MODEL=claude-sonnet-5

# Browser automation: self-hosted Playwright (chosen — see CLAUDE.md "Stack")
# `npm install` runs `playwright install chromium` automatically via postinstall

# Safety guard: comma-separated list of allowed target domains, enforced in code before navigation
ALLOWED_TARGET_DOMAINS=saucedemo.com,goran-tomicic.xyz
